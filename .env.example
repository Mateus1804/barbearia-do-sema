PORT=3000
NODE_ENV=development
# Use um caminho persistente no deploy, por exemplo /data/barbearia.db
DB_PATH=./data/barbearia.db
ADMIN_EMAIL=sema@barbeariadosema.com.br
ADMIN_PASSWORD=Sema@2026!
# Gere uma chave longa e aleatória antes de publicar:
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# URL pública do site; opcional para links absolutos.
PUBLIC_URL=http://localhost:3000

# Envio dos lembretes por e-mail (SMTP). Sem esses dados, os lembretes ficam desativados.
# Exemplo Gmail: host smtp.gmail.com, porta 587, secure false; use uma senha de app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
